# Copy to .env.local and fill in. lib/env.ts fails the build if any is missing.

# ---- public: inlined into the browser bundle, never put a secret here -------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp line staffed by curators, shown across the app. Affected people are
# not the ones using this app — this is how they get in. Digits only, with the
# country code: 57 for Colombia.
NEXT_PUBLIC_CURATOR_WHATSAPP="573000000000"

# ---- server only: never prefixed NEXT_PUBLIC_ -------------------------------
# Bypasses row-level security. Only *.dal.ts may reach it.
SUPABASE_SECRET_KEY=""

# Turnstile keys land here when the public report form ships. The CSP in
# next.config.ts already allows the Cloudflare host.
