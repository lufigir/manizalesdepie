# The demo runs with no environment at all — this file is one optional line.
#
# `NEXT_PUBLIC_SITE_URL` is the absolute base every opengraph image, the
# sitemap and the robots file resolve against. Without it, `lib/env.ts` falls
# back to Vercel's own production URL, and to http://localhost:3000 outside
# it. Set it when the site has a domain of its own.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
